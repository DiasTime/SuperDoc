# ─── Copy to .env and fill in. Never commit .env ───

# Postgres
POSTGRES_USER=docres
POSTGRES_PASSWORD=docres_dev_password
POSTGRES_DB=docres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://docres:docres_dev_password@postgres:5432/docres

# Redis (queue)
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO locally, S3 in prod)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docres
S3_REGION=us-east-1

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI — document understanding (Qwen-VL via an OpenAI-compatible endpoint)
#   Dev: local Ollama → `ollama pull qwen2.5vl`
#   Prod: point VL_ENDPOINT at a vLLM server (VL_BACKEND=vllm, set VL_MODEL_NAME)
# NOTE: from inside the Docker worker, the host's Ollama is host.docker.internal,
#       so set VL_ENDPOINT=http://host.docker.internal:11434/v1 for `docker compose`.
VL_BACKEND=ollama
VL_MODEL_NAME=qwen2.5vl
VL_ENDPOINT=http://localhost:11434/v1
VL_API_KEY=ollama
VL_MAX_TOKENS=4096
VL_TIMEOUT=180
VL_ENABLED=true

# Image restoration tuning
RESTORE_MAX_SIDE=3500    # working-resolution cap; higher = crisper small text, bigger files
RESTORE_MODE=color       # color: keep stamps/signatures/photos in colour (default) | gray | binary (pure-text only)

# Upload limits / security
MAX_UPLOAD_MB=25
MAX_PAGES=50
