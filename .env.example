# ─── Copy to .env and fill in. Never commit .env ───

# Postgres
POSTGRES_USER=docres
POSTGRES_PASSWORD=docres_dev_password
POSTGRES_DB=docres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://docres:docres_dev_password@postgres:5432/docres

# Redis (queue)
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO locally, S3 in prod)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docres
S3_REGION=us-east-1

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI — self-hosted Qwen2.5-VL 7B (served via vLLM)
VL_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
VL_ENDPOINT=http://vllm:8001/v1
VL_MAX_TOKENS=4096

# Upload limits / security
MAX_UPLOAD_MB=25
MAX_PAGES=50
