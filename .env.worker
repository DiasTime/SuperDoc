# Worker environment (Docker container `docres-worker-ocr`).
#
# The worker runs INSIDE Docker but talks to services in three places:
#   - Redis + MinIO  -> by compose service name on the `superdoc_default` network
#   - Postgres + Ollama -> on the host, via `host.docker.internal`
# That's why these values differ from the root .env (which uses localhost for
# the natively-run API). Consumed by start.bat:  docker run --env-file .env.worker
DATABASE_URL=postgresql://postgres:3418@host.docker.internal:5432/docres
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=docres:jobs

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docres
S3_REGION=us-east-1

LOG_LEVEL=INFO

# AI — document understanding (Qwen-VL via host Ollama)
VL_BACKEND=ollama
VL_MODEL_NAME=qwen2.5vl:3b
VL_ENDPOINT=http://host.docker.internal:11434/v1
VL_API_KEY=ollama
VL_TIMEOUT=180

# Image restoration
RESTORE_MODE=color
RESTORE_MAX_SIDE=3500
